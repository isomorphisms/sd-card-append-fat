#!/bin/sh
set -eu

export PATH=/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/card /tmp

mount -t appendfat /dev/vda /mnt/card

/bin/fallocate-keep-size keep /mnt/card/zero.bin 0 1048576 0

printf 'prefix\n' > /mnt/card/prefix.txt
/bin/fallocate-keep-size keep /mnt/card/prefix.txt 0 1048576 7
printf 'tail\n' >> /mnt/card/prefix.txt
/bin/fallocate-keep-size size /mnt/card/prefix.txt 12

printf 'partial\n' > /mnt/card/partial.txt
/bin/fallocate-keep-size keep /mnt/card/partial.txt 0 2097152 8
printf 'x\n' >> /mnt/card/partial.txt
/bin/fallocate-keep-size size /mnt/card/partial.txt 10

dd if=/dev/zero of=/tmp/one-megabyte bs=4096 count=256
dd if=/dev/zero of=/mnt/card/multi.bin bs=4096 count=1
/bin/fallocate-keep-size keep /mnt/card/multi.bin 0 4194304 4096
cat /tmp/one-megabyte >> /mnt/card/multi.bin
/bin/fallocate-keep-size size /mnt/card/multi.bin 1052672

printf 'unused\n' > /mnt/card/unused.txt
/bin/fallocate-keep-size keep /mnt/card/unused.txt 0 1048576 7

printf 'truncate-me\n' > /mnt/card/truncate.txt
/bin/fallocate-keep-size keep /mnt/card/truncate.txt 0 1048576 12
/bin/fallocate-keep-size truncate /mnt/card/truncate.txt 4
/bin/fallocate-keep-size blocks /mnt/card/truncate.txt 1

/bin/fallocate-keep-size reserve-clusters /mnt/card/batch.bin 17
/bin/fallocate-keep-size extend-clusters /mnt/card/batch.bin 17 19
/bin/fallocate-keep-size extend-clusters /mnt/card/batch.bin 19 19

printf 'unlink-me\n' > /mnt/card/unlink-reserved.txt
/bin/fallocate-keep-size keep /mnt/card/unlink-reserved.txt 0 1048576 10
rm /mnt/card/unlink-reserved.txt

sync
umount /mnt/card

mount -t vfat /dev/vda /mnt/card
grep -qx 'prefix' /mnt/card/prefix.txt
grep -qx 'tail' /mnt/card/prefix.txt
/bin/fallocate-keep-size size /mnt/card/prefix.txt 12
/bin/fallocate-keep-size size /mnt/card/partial.txt 10
/bin/fallocate-keep-size size /mnt/card/multi.bin 1052672
/bin/fallocate-keep-size size /mnt/card/unused.txt 7
/bin/fallocate-keep-size size /mnt/card/truncate.txt 4
/bin/fallocate-keep-size blocks /mnt/card/truncate.txt 1
/bin/fallocate-keep-size size /mnt/card/batch.bin 0
/bin/fallocate-keep-size blocks /mnt/card/batch.bin 0
if [ -e /mnt/card/unlink-reserved.txt ]; then
	printf '%s\n' 'unlink-reserved.txt survived stock-vfat remount' >&2
	exit 1
fi
umount /mnt/card

mount -t appendfat /dev/vdb /mnt/card
/bin/fallocate-keep-size expect-enospc /mnt/card/enospc.bin 0 1073741824 0
sync
umount /mnt/card

mount -t vfat /dev/vdb /mnt/card
/bin/fallocate-keep-size size /mnt/card/enospc.bin 0
rm /mnt/card/enospc.bin
sync
umount /mnt/card

/bin/fallocate-keep-size kernel-marker APPENDFAT_QEMU_KEEP_SIZE_PASS
poweroff -f
